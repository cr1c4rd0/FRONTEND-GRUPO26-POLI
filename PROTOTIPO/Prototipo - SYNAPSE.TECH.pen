                          "name": "Quote Text",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "“Esta tecnología no reemplaza al médico, pero puede reducir hasta en un 30% el tiempo de diagnóstico en casos complejos.”",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-heading",
                          "fontSize": 20,
                          "fontWeight": "500"
                        }
